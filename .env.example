# Neo4j Configuration
# For live E2E tests ONLY — never set to production URI in CI
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set on VM>
# Required to run destructive live tests against non-localhost Neo4j:
# ALLOW_PRODUCTION_NEO4J=true

# Google OAuth - Web App Client (for validating browser-based ID tokens)
GOOGLE_CLIENT_ID=160698144102-v9a0shre6ntap7jitla83b82i5akl1j0.apps.googleusercontent.com

# Google OAuth - Device Flow Client (for headless agent auth)
GOOGLE_DEVICE_CLIENT_ID=160698144102-n08j36n5orda34qe0hekmunp9pl8hrjm.apps.googleusercontent.com
GOOGLE_DEVICE_CLIENT_SECRET=<set on VM, do not commit>

# Agent Authentication
AGENT_API_KEYS=<comma-separated static keys for agent access>

# Pipeline Service Account
PIPELINE_SA_KEY_PATH=/scion-volumes/scratchpad/agents-kg-pipeline-sa-key.json

# Google GenAI Configuration
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_API_KEY=your-api-key

# Wikidata SPARQL Configuration
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_USER_AGENT=agents-kg/0.1 (https://github.com/user/agents-kg)
WIKIDATA_RATE_LIMIT=2.0
