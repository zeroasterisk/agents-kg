---
import fs from 'node:fs';
import path from 'node:path';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

async function query(cypher: string) {
  const res = await fetch(`${API}/query`, {
    method: 'POST', headers,
    body: JSON.stringify({ cypher }),
  });
  const data = await res.json();
  return data.results || [];
}

let seedEdges: any[] = [];
let entityDescs: Record<string, string> = {};
let neighborMap: Record<string, any[]> = {};

try {
  seedEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.type IN ['Protocol', 'Project'] AND m.type IN ['Protocol', 'Project', 'Organization', 'Group']
    WITH n, r, m
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 300
  `);

  const entityNames = new Set<string>();
  for (const e of seedEdges) {
    entityNames.add(e.source);
    entityNames.add(e.target);
  }

  const descResults = await query(`
    MATCH (e:Entity)
    WHERE e.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN e.name as name, e.type as type, e.description as description
  `);
  for (const d of descResults) {
    entityDescs[`${d.name}::${d.type}`] = d.description || '';
  }

  const allEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    OR m.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 3000
  `);

  for (const e of allEdges) {
    const srcKey = `${e.source}::${e.source_type}`;
    const tgtKey = `${e.target}::${e.target_type}`;
    if (!neighborMap[srcKey]) neighborMap[srcKey] = [];
    if (!neighborMap[tgtKey]) neighborMap[tgtKey] = [];
    neighborMap[srcKey].push(e);
    neighborMap[tgtKey].push(e);
  }

  const expandedNames = new Set<string>();
  for (const e of allEdges) {
    expandedNames.add(e.source);
    expandedNames.add(e.target);
  }
  const newNames = [...expandedNames].filter(n => !entityNames.has(n));
  if (newNames.length > 0) {
    const moreDescs = await query(`
      MATCH (e:Entity)
      WHERE e.name IN [${newNames.slice(0, 500).map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
      RETURN e.name as name, e.type as type, e.description as description
    `);
    for (const d of moreDescs) {
      entityDescs[`${d.name}::${d.type}`] = d.description || '';
    }
  }
} catch (e) {}

const distDir = path.resolve('./dist');
fs.mkdirSync(distDir, { recursive: true });
fs.writeFileSync(
  path.join(distDir, 'graph-data.json'),
  JSON.stringify({ seedEdges, entityDescs, neighborMap })
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataUrl = `${base}/graph-data.json`;
---

<div id="graph-container" class="relative w-full bg-surface border border-border rounded-lg overflow-hidden" style="height: 600px;">
  <div id="cy" class="w-full h-full"></div>
  <div id="graph-loading" class="absolute inset-0 flex items-center justify-center bg-surface">
    <span class="text-muted text-sm">Loading graph...</span>
  </div>
  <div id="node-info" class="absolute top-3 right-3 w-72 bg-bg/95 border border-border rounded-lg p-4 hidden backdrop-blur-sm">
    <button id="close-info" class="absolute top-2 right-2 text-muted hover:text-white text-xs">&times;</button>
    <h3 id="info-name" class="text-white font-semibold text-sm mb-1"></h3>
    <span id="info-type" class="inline-block text-[10px] px-1.5 py-0.5 rounded mb-2"></span>
    <p id="info-desc" class="text-xs text-muted mb-2"></p>
    <p id="info-rels" class="text-[10px] text-muted"></p>
  </div>
  <div id="type-filters" class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
    <button data-type="Protocol" data-color="#3b82f6" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(59,130,246,0.4); color: rgba(147,197,253,0.6);">Protocol</button>
    <button data-type="Project" data-color="#10b981" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(16,185,129,0.4); color: rgba(110,231,183,0.6);">Project</button>
    <button data-type="Organization" data-color="#22c55e" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(34,197,94,0.4); color: rgba(134,239,172,0.6);">Organization</button>
    <button data-type="Person" data-color="#f97316" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(249,115,22,0.4); color: rgba(253,186,116,0.6);">Person</button>
    <button data-type="Capability" data-color="#a855f7" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(168,85,247,0.4); color: rgba(196,148,252,0.6);">Capability</button>
    <button data-type="Group" data-color="#14b8a6" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(20,184,166,0.4); color: rgba(94,234,212,0.6);">Group</button>
  </div>
  <div class="absolute bottom-3 right-3 flex gap-1">
    <button id="btn-reset" class="text-[10px] px-2 py-1 rounded bg-surface border border-border text-muted hover:text-white cursor-pointer">Reset</button>
  </div>
</div>

<div id="graph-data-url" style="display:none" data-url={dataUrl}></div>

<script>
  import cytoscape from 'cytoscape';

  const TYPE_COLORS: Record<string, string> = {
    Protocol: '#3b82f6',
    Project: '#10b981',
    Organization: '#22c55e',
    Person: '#f97316',
    Capability: '#a855f7',
    Group: '#14b8a6',
  };

  const loadedNodes = new Set<string>();
  const loadedEdges = new Set<string>();
  const activeFilters = new Set<string>();
  let cyInstance: any = null;
  let allSeedEdges: any[] = [];
  let entityDescs: Record<string, any> = {};
  let neighborMap: Record<string, any[]> = {};

  function toElements(results: any[]) {
    const elements: any[] = [];
    for (const r of results) {
      const srcId = `${r.source}::${r.source_type}`;
      const tgtId = `${r.target}::${r.target_type}`;
      const edgeId = `${srcId}-${r.rel}-${tgtId}`;

      if (!loadedNodes.has(srcId)) {
        loadedNodes.add(srcId);
        elements.push({
          data: {
            id: srcId,
            label: r.source.length > 30 ? r.source.slice(0, 28) + '...' : r.source,
            fullName: r.source,
            type: r.source_type,
            color: TYPE_COLORS[r.source_type] || '#6b7280',
          },
        });
      }
      if (!loadedNodes.has(tgtId)) {
        loadedNodes.add(tgtId);
        elements.push({
          data: {
            id: tgtId,
            label: r.target.length > 30 ? r.target.slice(0, 28) + '...' : r.target,
            fullName: r.target,
            type: r.target_type,
            color: TYPE_COLORS[r.target_type] || '#6b7280',
          },
        });
      }
      if (!loadedEdges.has(edgeId)) {
        loadedEdges.add(edgeId);
        elements.push({
          data: {
            id: edgeId,
            source: srcId,
            target: tgtId,
            label: r.rel.replace(/_/g, ' ').toLowerCase(),
          },
        });
      }
    }
    return elements;
  }

  function setButtonActive(btn: HTMLElement, active: boolean) {
    const color = btn.getAttribute('data-color') || '#6b7280';
    if (active) {
      btn.style.background = color + '40';
      btn.style.borderColor = color;
      btn.style.color = '#ffffff';
    } else {
      btn.style.background = 'transparent';
      btn.style.borderColor = color + '66';
      btn.style.color = color + '99';
    }
  }

  function rebuildGraph() {
    if (!cyInstance) return;

    loadedNodes.clear();
    loadedEdges.clear();

    let filteredEdges: any[];
    if (activeFilters.size === 0) {
      filteredEdges = allSeedEdges;
    } else {
      filteredEdges = allSeedEdges.filter((e: any) =>
        activeFilters.has(e.source_type) || activeFilters.has(e.target_type)
      );
    }

    const elements = toElements(filteredEdges);
    cyInstance.elements().remove();
    cyInstance.add(elements);
    cyInstance.layout({
      name: 'cose',
      animate: false,
      nodeOverlap: 20,
      idealEdgeLength: 80,
      nodeRepulsion: function () { return 8000; },
      gravity: 0.25,
    }).run();
    cyInstance.fit(undefined, 30);
  }

  function focusOnNode(cy: any, node: any) {
    const neighborhood = node.closedNeighborhood();
    cy.elements().style({ opacity: 0.06 });
    neighborhood.style({ opacity: 1 });
    neighborhood.nodes().style({ opacity: 1 });
    neighborhood.edges().style({ opacity: 0.8 });
    node.style({ opacity: 1, 'border-width': 3, 'border-color': '#818cf8', width: 26, height: 26 });
    cy.animate({
      fit: { eles: neighborhood, padding: 50 },
      duration: 400,
      easing: 'ease-out',
    });
  }

  function clearFocus(cy: any) {
    cy.elements().style({ opacity: 1 });
    cy.nodes().style({ 'border-width': 1, 'border-color': '#2a2d3a', width: 18, height: 18 });
    cy.fit(undefined, 30);
  }

  async function start() {
    const dataUrl = document.getElementById('graph-data-url')!.getAttribute('data-url')!;
    const res = await fetch(dataUrl);
    const raw = await res.json();
    allSeedEdges = raw.seedEdges;
    entityDescs = raw.entityDescs;
    neighborMap = raw.neighborMap;

    const elements = toElements(allSeedEdges);

    cyInstance = cytoscape({
      container: document.getElementById('cy'),
      elements,
      style: [
        {
          selector: 'node',
          style: {
            'background-color': 'data(color)',
            label: 'data(label)',
            color: '#e5e7eb',
            'font-size': '9px',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            width: 18,
            height: 18,
            'border-width': 1,
            'border-color': '#2a2d3a',
            'text-max-width': '100px',
            'text-wrap': 'ellipsis',
          },
        },
        {
          selector: 'edge',
          style: {
            width: 1,
            'line-color': '#2a2d3a',
            'target-arrow-color': '#2a2d3a',
            'target-arrow-shape': 'triangle',
            'arrow-scale': 0.6,
            'curve-style': 'bezier',
          },
        },
      ],
      layout: {
        name: 'cose',
        animate: false,
        nodeOverlap: 20,
        idealEdgeLength: 80,
        nodeRepulsion: function () { return 8000; },
        gravity: 0.25,
      },
    });

    document.getElementById('graph-loading')?.remove();
    const cy = cyInstance;

    const infoPanel = document.getElementById('node-info');
    const infoName = document.getElementById('info-name');
    const infoType = document.getElementById('info-type');
    const infoDesc = document.getElementById('info-desc');
    const infoRels = document.getElementById('info-rels');

    // --- Type filter toggle buttons ---
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).getAttribute('data-type')!;
        if (activeFilters.has(type)) {
          activeFilters.delete(type);
          setButtonActive(btn as HTMLElement, false);
        } else {
          activeFilters.add(type);
          setButtonActive(btn as HTMLElement, true);
        }
        rebuildGraph();
      });
    });

    // --- Node tap: show info, expand neighbors, focus ---
    let focusedNode: any = null;

    cy.on('tap', 'node', function (evt: any) {
      const node = evt.target;
      const name = node.data('fullName');
      const type = node.data('type');
      const nodeId = `${name}::${type}`;

      if (infoPanel && infoName && infoType) {
        infoName.textContent = name;
        infoType.textContent = type;
        const color = TYPE_COLORS[type] || '#6b7280';
        infoType.style.background = color + '33';
        infoType.style.color = color;
        infoPanel.classList.remove('hidden');
      }

      if (infoDesc) {
        infoDesc.textContent = entityDescs[nodeId] || '';
      }

      // Expand neighbors from pre-fetched data
      const neighbors = neighborMap[nodeId] || [];
      const limited = neighbors.slice(0, 20);

      if (infoRels) {
        infoRels.textContent = limited.length > 0
          ? `${limited.length} relationships${neighbors.length > 20 ? ` (showing 20 of ${neighbors.length})` : ''}`
          : 'No additional relationships';
      }

      const newElements = toElements(limited);
      if (newElements.length > 0) {
        cy.add(newElements);
        cy.layout({
          name: 'cose',
          animate: false,
          nodeOverlap: 20,
          idealEdgeLength: 80,
          nodeRepulsion: function () { return 8000; },
          gravity: 0.25,
        }).run();
      }

      // Focus on this node's subnetwork
      focusedNode = node;
      focusOnNode(cy, node);
    });

    // --- Tap on background: clear focus ---
    cy.on('tap', function (evt: any) {
      if (evt.target === cy) {
        if (focusedNode) {
          focusedNode = null;
          clearFocus(cy);
        }
        infoPanel?.classList.add('hidden');
      }
    });

    document.getElementById('close-info')?.addEventListener('click', () => {
      infoPanel?.classList.add('hidden');
    });

    // --- Reset button ---
    document.getElementById('btn-reset')?.addEventListener('click', () => {
      activeFilters.clear();
      focusedNode = null;
      infoPanel?.classList.add('hidden');
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        setButtonActive(btn as HTMLElement, false);
      });
      loadedNodes.clear();
      loadedEdges.clear();
      cyInstance.elements().remove();
      const els = toElements(allSeedEdges);
      cyInstance.add(els);
      cyInstance.layout({
        name: 'cose',
        animate: false,
        nodeOverlap: 20,
        idealEdgeLength: 80,
        nodeRepulsion: function () { return 8000; },
        gravity: 0.25,
      }).run();
      cyInstance.fit(undefined, 30);
    });
  }

  start();
</script>
