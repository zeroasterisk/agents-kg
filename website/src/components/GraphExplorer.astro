---
import fs from 'node:fs';
import path from 'node:path';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

async function query(cypher: string) {
  const res = await fetch(`${API}/query`, {
    method: 'POST', headers,
    body: JSON.stringify({ cypher }),
  });
  const data = await res.json();
  return data.results || [];
}

let seedEdges: any[] = [];
let entityDescs: Record<string, string> = {};
let neighborMap: Record<string, any[]> = {};

try {
  seedEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.type IN ['Protocol', 'Project'] AND m.type IN ['Protocol', 'Project', 'Organization', 'Group']
    WITH n, r, m
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 300
  `);

  const entityNames = new Set<string>();
  for (const e of seedEdges) {
    entityNames.add(e.source);
    entityNames.add(e.target);
  }

  const descResults = await query(`
    MATCH (e:Entity)
    WHERE e.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN e.name as name, e.type as type, e.description as description
  `);
  for (const d of descResults) {
    entityDescs[`${d.name}::${d.type}`] = d.description || '';
  }

  const allEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    OR m.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 3000
  `);

  for (const e of allEdges) {
    const srcKey = `${e.source}::${e.source_type}`;
    const tgtKey = `${e.target}::${e.target_type}`;
    if (!neighborMap[srcKey]) neighborMap[srcKey] = [];
    if (!neighborMap[tgtKey]) neighborMap[tgtKey] = [];
    neighborMap[srcKey].push(e);
    neighborMap[tgtKey].push(e);
  }

  const expandedNames = new Set<string>();
  for (const e of allEdges) {
    expandedNames.add(e.source);
    expandedNames.add(e.target);
  }
  const newNames = [...expandedNames].filter(n => !entityNames.has(n));
  if (newNames.length > 0) {
    const moreDescs = await query(`
      MATCH (e:Entity)
      WHERE e.name IN [${newNames.slice(0, 500).map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
      RETURN e.name as name, e.type as type, e.description as description
    `);
    for (const d of moreDescs) {
      entityDescs[`${d.name}::${d.type}`] = d.description || '';
    }
  }
} catch (e) {}

const distDir = path.resolve('./dist');
fs.mkdirSync(distDir, { recursive: true });
fs.writeFileSync(
  path.join(distDir, 'graph-data.json'),
  JSON.stringify({ seedEdges, entityDescs, neighborMap })
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataUrl = `${base}/graph-data.json`;
---

<div id="graph-container" class="relative w-full bg-surface border border-border rounded-lg overflow-hidden" style="height: 600px;">
  <div id="cy" class="w-full h-full"></div>
  <div id="graph-loading" class="absolute inset-0 flex items-center justify-center bg-surface">
    <span class="text-muted text-sm">Loading graph...</span>
  </div>
  <div id="node-info" class="absolute top-3 right-3 w-72 bg-bg/95 border border-border rounded-lg p-4 hidden backdrop-blur-sm">
    <button id="close-info" class="absolute top-2 right-2 text-muted hover:text-white text-xs">&times;</button>
    <h3 id="info-name" class="text-white font-semibold text-sm mb-1"></h3>
    <span id="info-type" class="inline-block text-[10px] px-1.5 py-0.5 rounded mb-2"></span>
    <p id="info-desc" class="text-xs text-muted mb-2"></p>
    <p id="info-rels" class="text-[10px] text-muted"></p>
  </div>
  <div id="type-filters" class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
    <button data-type="Protocol" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-blue-500/40 text-blue-300/60 hover:bg-blue-500/20 hover:text-blue-300">Protocol</button>
    <button data-type="Project" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-emerald-500/40 text-emerald-300/60 hover:bg-emerald-500/20 hover:text-emerald-300">Project</button>
    <button data-type="Organization" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-green-500/40 text-green-300/60 hover:bg-green-500/20 hover:text-green-300">Organization</button>
    <button data-type="Person" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-orange-500/40 text-orange-300/60 hover:bg-orange-500/20 hover:text-orange-300">Person</button>
    <button data-type="Capability" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-purple-500/40 text-purple-300/60 hover:bg-purple-500/20 hover:text-purple-300">Capability</button>
    <button data-type="Group" class="filter-btn text-[10px] px-2 py-1 rounded border transition-all bg-transparent border-teal-500/40 text-teal-300/60 hover:bg-teal-500/20 hover:text-teal-300">Group</button>
  </div>
  <div class="absolute bottom-3 right-3 flex gap-1">
    <button id="btn-reset" class="text-[10px] px-2 py-1 rounded bg-surface border border-border text-muted hover:text-white">Reset</button>
  </div>
</div>

<div id="graph-data-url" style="display:none" data-url={dataUrl}></div>

<script>
  import cytoscape from 'cytoscape';

  const TYPE_COLORS: Record<string, string> = {
    Protocol: '#3b82f6',
    Project: '#10b981',
    Organization: '#22c55e',
    Person: '#f97316',
    Capability: '#a855f7',
    Group: '#14b8a6',
  };

  const FILTER_ACTIVE_CLASSES: Record<string, string> = {
    Protocol: 'bg-blue-500/30 border-blue-400 text-blue-200',
    Project: 'bg-emerald-500/30 border-emerald-400 text-emerald-200',
    Organization: 'bg-green-500/30 border-green-400 text-green-200',
    Person: 'bg-orange-500/30 border-orange-400 text-orange-200',
    Capability: 'bg-purple-500/30 border-purple-400 text-purple-200',
    Group: 'bg-teal-500/30 border-teal-400 text-teal-200',
  };

  const FILTER_INACTIVE_CLASSES: Record<string, string> = {
    Protocol: 'bg-transparent border-blue-500/40 text-blue-300/60',
    Project: 'bg-transparent border-emerald-500/40 text-emerald-300/60',
    Organization: 'bg-transparent border-green-500/40 text-green-300/60',
    Person: 'bg-transparent border-orange-500/40 text-orange-300/60',
    Capability: 'bg-transparent border-purple-500/40 text-purple-300/60',
    Group: 'bg-transparent border-teal-500/40 text-teal-300/60',
  };

  const loadedNodes = new Set<string>();
  const loadedEdges = new Set<string>();
  const activeFilters = new Set<string>();

  function toElements(results: any[]) {
    const elements: any[] = [];
    for (const r of results) {
      const srcId = `${r.source}::${r.source_type}`;
      const tgtId = `${r.target}::${r.target_type}`;
      const edgeId = `${srcId}-${r.rel}-${tgtId}`;

      if (!loadedNodes.has(srcId)) {
        loadedNodes.add(srcId);
        elements.push({
          data: {
            id: srcId,
            label: r.source.length > 30 ? r.source.slice(0, 28) + '...' : r.source,
            fullName: r.source,
            type: r.source_type,
            color: TYPE_COLORS[r.source_type] || '#6b7280',
          },
        });
      }
      if (!loadedNodes.has(tgtId)) {
        loadedNodes.add(tgtId);
        elements.push({
          data: {
            id: tgtId,
            label: r.target.length > 30 ? r.target.slice(0, 28) + '...' : r.target,
            fullName: r.target,
            type: r.target_type,
            color: TYPE_COLORS[r.target_type] || '#6b7280',
          },
        });
      }
      if (!loadedEdges.has(edgeId)) {
        loadedEdges.add(edgeId);
        elements.push({
          data: {
            id: edgeId,
            source: srcId,
            target: tgtId,
            label: r.rel.replace(/_/g, ' ').toLowerCase(),
          },
        });
      }
    }
    return elements;
  }

  function applyFilters(cy: any) {
    if (activeFilters.size === 0) {
      // No filters active = show all
      cy.elements().removeClass('filtered-out');
      cy.elements().style({ opacity: 1 });
      cy.edges().style({ opacity: 1 });
    } else {
      // Show only nodes matching active filters + their edges
      cy.nodes().forEach((node: any) => {
        const type = node.data('type');
        if (activeFilters.has(type)) {
          node.removeClass('filtered-out');
          node.style({ opacity: 1 });
        } else {
          node.addClass('filtered-out');
          node.style({ opacity: 0.08 });
        }
      });
      cy.edges().forEach((edge: any) => {
        const src = edge.source();
        const tgt = edge.target();
        if (!src.hasClass('filtered-out') && !tgt.hasClass('filtered-out')) {
          edge.style({ opacity: 1 });
        } else {
          edge.style({ opacity: 0.05 });
        }
      });
    }
  }

  function focusOnNode(cy: any, node: any) {
    // Get the connected component of this node
    const neighborhood = node.closedNeighborhood();

    // Dim everything
    cy.elements().style({ opacity: 0.06 });

    // Highlight the neighborhood
    neighborhood.style({ opacity: 1 });
    neighborhood.nodes().style({ opacity: 1 });
    neighborhood.edges().style({ opacity: 0.8 });

    // Also highlight the selected node distinctly
    node.style({ opacity: 1, 'border-width': 3, 'border-color': '#818cf8', width: 26, height: 26 });

    // Zoom to fit the subnetwork with padding
    cy.animate({
      fit: { eles: neighborhood, padding: 50 },
      duration: 400,
      easing: 'ease-out',
    });
  }

  function clearFocus(cy: any) {
    // Restore all nodes to default style
    cy.nodes().style({ 'border-width': 1, 'border-color': '#2a2d3a', width: 18, height: 18 });
    // Re-apply filters (which handles opacity)
    applyFilters(cy);
  }

  function updateFilterButton(btn: HTMLElement, type: string, active: boolean) {
    // Remove all styling classes
    const allClasses = `${FILTER_ACTIVE_CLASSES[type]} ${FILTER_INACTIVE_CLASSES[type]}`.split(' ');
    for (const c of allClasses) {
      if (c) btn.classList.remove(c);
    }
    // Add the right set
    const classes = active ? FILTER_ACTIVE_CLASSES[type] : FILTER_INACTIVE_CLASSES[type];
    for (const c of classes.split(' ')) {
      if (c) btn.classList.add(c);
    }
  }

  async function start() {
    const dataUrl = document.getElementById('graph-data-url')!.getAttribute('data-url')!;
    const res = await fetch(dataUrl);
    const raw = await res.json();
    const SEED_EDGES = raw.seedEdges;
    const ENTITY_DESCS = raw.entityDescs;
    const NEIGHBOR_MAP = raw.neighborMap;

    const elements = toElements(SEED_EDGES);

    const cy = cytoscape({
      container: document.getElementById('cy'),
      elements,
      style: [
        {
          selector: 'node',
          style: {
            'background-color': 'data(color)',
            label: 'data(label)',
            color: '#e5e7eb',
            'font-size': '9px',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            width: 18,
            height: 18,
            'border-width': 1,
            'border-color': '#2a2d3a',
            'text-max-width': '100px',
            'text-wrap': 'ellipsis',
          },
        },
        {
          selector: 'edge',
          style: {
            width: 1,
            'line-color': '#2a2d3a',
            'target-arrow-color': '#2a2d3a',
            'target-arrow-shape': 'triangle',
            'arrow-scale': 0.6,
            'curve-style': 'bezier',
          },
        },
      ],
      layout: {
        name: 'cose',
        animate: false,
        nodeOverlap: 20,
        idealEdgeLength: 80,
        nodeRepulsion: function () { return 8000; },
        gravity: 0.25,
      },
    });

    document.getElementById('graph-loading')?.remove();

    const infoPanel = document.getElementById('node-info');
    const infoName = document.getElementById('info-name');
    const infoType = document.getElementById('info-type');
    const infoDesc = document.getElementById('info-desc');
    const infoRels = document.getElementById('info-rels');

    // --- Type filter toggle buttons ---
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).getAttribute('data-type')!;
        if (activeFilters.has(type)) {
          activeFilters.delete(type);
          updateFilterButton(btn as HTMLElement, type, false);
        } else {
          activeFilters.add(type);
          updateFilterButton(btn as HTMLElement, type, true);
        }
        applyFilters(cy);
      });
    });

    // --- Node tap: show info, expand neighbors, focus ---
    let focusedNode: any = null;

    cy.on('tap', 'node', function (evt: any) {
      const node = evt.target;
      const name = node.data('fullName');
      const type = node.data('type');
      const nodeId = `${name}::${type}`;

      if (infoPanel && infoName && infoType) {
        infoName.textContent = name;
        infoType.textContent = type;
        infoType.className = 'inline-block text-[10px] px-1.5 py-0.5 rounded mb-2';
        const colorClass: Record<string, string> = {
          Protocol: 'bg-blue-500/20 text-blue-300',
          Project: 'bg-emerald-500/20 text-emerald-300',
          Organization: 'bg-green-500/20 text-green-300',
          Person: 'bg-orange-500/20 text-orange-300',
          Capability: 'bg-purple-500/20 text-purple-300',
          Group: 'bg-teal-500/20 text-teal-300',
        };
        infoType.className += ` ${colorClass[type] || 'bg-gray-500/20 text-gray-400'}`;
        infoPanel.classList.remove('hidden');
      }

      if (infoDesc) {
        infoDesc.textContent = ENTITY_DESCS[nodeId] || '';
      }

      // Expand neighbors from pre-fetched data
      const neighbors = NEIGHBOR_MAP[nodeId] || [];
      const limited = neighbors.slice(0, 20);

      if (infoRels) {
        infoRels.textContent = limited.length > 0
          ? `${limited.length} relationships${neighbors.length > 20 ? ` (showing 20 of ${neighbors.length})` : ''}`
          : 'No additional relationships';
      }

      const newElements = toElements(limited);
      if (newElements.length > 0) {
        cy.add(newElements);
        cy.layout({
          name: 'cose',
          animate: false,
          nodeOverlap: 20,
          idealEdgeLength: 80,
          nodeRepulsion: function () { return 8000; },
          gravity: 0.25,
        }).run();
      }

      // Focus on this node's subnetwork
      focusedNode = node;
      focusOnNode(cy, node);
    });

    // --- Tap on background: clear focus ---
    cy.on('tap', function (evt: any) {
      if (evt.target === cy) {
        if (focusedNode) {
          focusedNode = null;
          clearFocus(cy);
        }
        infoPanel?.classList.add('hidden');
      }
    });

    document.getElementById('close-info')?.addEventListener('click', () => {
      infoPanel?.classList.add('hidden');
    });

    // --- Reset button ---
    document.getElementById('btn-reset')?.addEventListener('click', () => {
      loadedNodes.clear();
      loadedEdges.clear();
      activeFilters.clear();
      focusedNode = null;
      cy.elements().remove();
      infoPanel?.classList.add('hidden');
      // Reset filter buttons to inactive
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        const type = (btn as HTMLElement).getAttribute('data-type')!;
        updateFilterButton(btn as HTMLElement, type, false);
      });
      start();
    });
  }

  start();
</script>
