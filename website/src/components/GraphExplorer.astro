---
import fs from 'node:fs';
import path from 'node:path';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

async function query(cypher: string) {
  const res = await fetch(`${API}/query`, {
    method: 'POST', headers,
    body: JSON.stringify({ cypher }),
  });
  const data = await res.json();
  return data.results || [];
}

let seedEdges: any[] = [];
let entityDescs: Record<string, string> = {};
let neighborMap: Record<string, any[]> = {};

try {
  // Fetch edges across ALL entity types for a richer seed graph
  seedEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.type IN ['Protocol', 'Project', 'Organization', 'Group', 'Person', 'Capability']
    AND m.type IN ['Protocol', 'Project', 'Organization', 'Group', 'Person', 'Capability']
    WITH n, r, m
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 500
  `);

  const entityNames = new Set<string>();
  for (const e of seedEdges) {
    entityNames.add(e.source);
    entityNames.add(e.target);
  }

  const descResults = await query(`
    MATCH (e:Entity)
    WHERE e.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN e.name as name, e.type as type, e.description as description
  `);
  for (const d of descResults) {
    entityDescs[`${d.name}::${d.type}`] = d.description || '';
  }

  const allEdges = await query(`
    MATCH (n:Entity)-[r]->(m:Entity)
    WHERE n.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    OR m.name IN [${[...entityNames].map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
    RETURN n.name as source, n.type as source_type, type(r) as rel, m.name as target, m.type as target_type
    LIMIT 5000
  `);

  for (const e of allEdges) {
    const srcKey = `${e.source}::${e.source_type}`;
    const tgtKey = `${e.target}::${e.target_type}`;
    if (!neighborMap[srcKey]) neighborMap[srcKey] = [];
    if (!neighborMap[tgtKey]) neighborMap[tgtKey] = [];
    neighborMap[srcKey].push(e);
    neighborMap[tgtKey].push(e);
  }

  const expandedNames = new Set<string>();
  for (const e of allEdges) {
    expandedNames.add(e.source);
    expandedNames.add(e.target);
  }
  const newNames = [...expandedNames].filter(n => !entityNames.has(n));
  if (newNames.length > 0) {
    const moreDescs = await query(`
      MATCH (e:Entity)
      WHERE e.name IN [${newNames.slice(0, 500).map(n => `"${n.replace(/"/g, '\\"')}"`).join(',')}]
      RETURN e.name as name, e.type as type, e.description as description
    `);
    for (const d of moreDescs) {
      entityDescs[`${d.name}::${d.type}`] = d.description || '';
    }
  }
} catch (e) {}

const distDir = path.resolve('./dist');
fs.mkdirSync(distDir, { recursive: true });
fs.writeFileSync(
  path.join(distDir, 'graph-data.json'),
  JSON.stringify({ seedEdges, entityDescs, neighborMap })
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataUrl = `${base}/graph-data.json`;
---

<div id="graph-container" class="relative w-full bg-surface border border-border rounded-lg overflow-hidden" style="height: 600px;">
  <div id="cy" class="w-full h-full"></div>
  <div id="graph-loading" class="absolute inset-0 flex items-center justify-center bg-surface">
    <span class="text-muted text-sm">Loading graph...</span>
  </div>

  <!-- Search box -->
  <div class="absolute top-3 left-3 w-40 sm:w-56">
    <input id="graph-search" type="text" aria-label="Search graph nodes" placeholder="Search nodes..."
      style="width:100%;font-size:11px;padding:5px 10px;border-radius:6px;background:rgba(15,17,23,0.95);border:1px solid #2a2d3a;color:#ffffff;outline:none;" />
    <div id="search-results" class="hidden mt-1 max-h-48 overflow-y-auto bg-bg/95 border border-border rounded backdrop-blur-sm"></div>
  </div>

  <!-- Info panel -->
  <div id="node-info" class="absolute top-3 right-3 w-64 sm:w-72 max-w-[calc(100%-1.5rem)] bg-bg/95 border border-border rounded-lg p-3 sm:p-4 hidden backdrop-blur-sm">
    <div class="flex items-center justify-between mb-2">
      <div id="history-nav" class="flex items-center gap-1">
        <button id="btn-back" aria-label="Go back in browse history" class="text-muted hover:text-white disabled:opacity-20 disabled:cursor-default" disabled style="font-size:14px;">&#9664;</button>
        <button id="btn-forward" aria-label="Go forward in browse history" class="text-muted hover:text-white disabled:opacity-20 disabled:cursor-default" disabled style="font-size:14px;">&#9654;</button>
      </div>
      <button id="close-info" aria-label="Close info panel and reset view" class="text-muted hover:text-white text-sm leading-none">&times;</button>
    </div>
    <h3 id="info-name" class="text-white font-semibold text-sm mb-1"></h3>
    <span id="info-type" class="inline-block text-[10px] px-1.5 py-0.5 rounded mb-2"></span>
    <p id="info-desc" class="text-xs text-muted mb-2"></p>
    <p id="info-rels" class="text-[10px] text-muted"></p>
    <div id="edge-detail" class="hidden mt-2 pt-2 border-t border-border/50">
      <p class="text-[10px] font-medium text-muted uppercase tracking-wider mb-1">Selected Edge</p>
      <div id="edge-info" class="text-xs text-gray-300"></div>
    </div>
  </div>

  <!-- Type filter toggles -->
  <div id="type-filters" class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
    <button data-type="Protocol" data-color="#3b82f6" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(59,130,246,0.4); color: rgba(147,197,253,0.6);">Protocol</button>
    <button data-type="Project" data-color="#10b981" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(16,185,129,0.4); color: rgba(110,231,183,0.6);">Project</button>
    <button data-type="Organization" data-color="#22c55e" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(34,197,94,0.4); color: rgba(134,239,172,0.6);">Organization</button>
    <button data-type="Person" data-color="#f97316" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(249,115,22,0.4); color: rgba(253,186,116,0.6);">Person</button>
    <button data-type="Capability" data-color="#a855f7" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(168,85,247,0.4); color: rgba(196,148,252,0.6);">Capability</button>
    <button data-type="Group" data-color="#14b8a6" class="filter-btn text-[10px] px-2.5 py-1 rounded border cursor-pointer" style="background: transparent; border-color: rgba(20,184,166,0.4); color: rgba(94,234,212,0.6);">Group</button>
  </div>

  <div class="absolute bottom-3 right-3 flex gap-1">
    <button id="btn-reset" class="text-[10px] px-2 py-1 rounded bg-surface border border-border text-muted hover:text-white cursor-pointer">Reset</button>
  </div>
</div>

<div id="graph-data-url" style="display:none" data-url={dataUrl}></div>

<script>
  import cytoscape from 'cytoscape';

  const TYPE_COLORS: Record<string, string> = {
    Protocol: '#3b82f6',
    Project: '#10b981',
    Organization: '#22c55e',
    Person: '#f97316',
    Capability: '#a855f7',
    Group: '#14b8a6',
  };

  const DIM_OPACITY = 0.12;

  const loadedNodes = new Set<string>();
  const loadedEdges = new Set<string>();
  const activeFilters = new Set<string>();
  let cyInstance: any = null;
  let allSeedEdges: any[] = [];
  let entityDescs: Record<string, any> = {};
  let neighborMap: Record<string, any[]> = {};

  // Browse history
  const history: string[] = [];
  let historyIndex = -1;

  function toElements(results: any[]) {
    const elements: any[] = [];
    for (const r of results) {
      const srcId = `${r.source}::${r.source_type}`;
      const tgtId = `${r.target}::${r.target_type}`;
      const edgeId = `${srcId}-${r.rel}-${tgtId}`;

      if (!loadedNodes.has(srcId)) {
        loadedNodes.add(srcId);
        elements.push({
          data: {
            id: srcId,
            label: r.source.length > 30 ? r.source.slice(0, 28) + '...' : r.source,
            fullName: r.source,
            type: r.source_type,
            color: TYPE_COLORS[r.source_type] || '#6b7280',
          },
        });
      }
      if (!loadedNodes.has(tgtId)) {
        loadedNodes.add(tgtId);
        elements.push({
          data: {
            id: tgtId,
            label: r.target.length > 30 ? r.target.slice(0, 28) + '...' : r.target,
            fullName: r.target,
            type: r.target_type,
            color: TYPE_COLORS[r.target_type] || '#6b7280',
          },
        });
      }
      if (!loadedEdges.has(edgeId)) {
        loadedEdges.add(edgeId);
        elements.push({
          data: {
            id: edgeId,
            source: srcId,
            target: tgtId,
            label: r.rel.replace(/_/g, ' ').toLowerCase(),
          },
        });
      }
    }
    return elements;
  }

  function setButtonActive(btn: HTMLElement, active: boolean) {
    const color = btn.getAttribute('data-color') || '#6b7280';
    if (active) {
      btn.style.background = color + '40';
      btn.style.borderColor = color;
      btn.style.color = '#ffffff';
    } else {
      btn.style.background = 'transparent';
      btn.style.borderColor = color + '66';
      btn.style.color = color + '99';
    }
  }

  function applyTypeFilters() {
    if (!cyInstance) return;
    const cy = cyInstance;

    if (activeFilters.size === 0) {
      cy.nodes().style({ opacity: 1 });
      cy.edges().style({ opacity: 1 });
    } else {
      cy.nodes().forEach((node: any) => {
        const type = node.data('type');
        if (activeFilters.has(type)) {
          node.style({ opacity: 1 });
        } else {
          node.style({ opacity: DIM_OPACITY });
        }
      });
      cy.edges().forEach((edge: any) => {
        const srcType = edge.source().data('type');
        const tgtType = edge.target().data('type');
        const srcActive = activeFilters.has(srcType);
        const tgtActive = activeFilters.has(tgtType);
        if (srcActive || tgtActive) {
          edge.style({ opacity: srcActive && tgtActive ? 1 : 0.4 });
        } else {
          edge.style({ opacity: 0.04 });
        }
      });
    }
  }

  function focusOnNode(cy: any, nodeId: string, addToHistory: boolean) {
    const node = cy.getElementById(nodeId);
    if (!node || node.empty()) return;

    if (addToHistory) {
      // Truncate forward history if we branched
      if (historyIndex < history.length - 1) {
        history.splice(historyIndex + 1);
      }
      history.push(nodeId);
      historyIndex = history.length - 1;
    }
    updateHistoryButtons();

    // Expand neighbors
    const name = node.data('fullName');
    const type = node.data('type');
    const nId = `${name}::${type}`;
    const neighbors = neighborMap[nId] || [];
    const newElements = toElements(neighbors);
    if (newElements.length > 0) {
      cy.add(newElements);
    }

    // Get the neighborhood
    const neighborhood = node.closedNeighborhood();

    // Dim everything first
    cy.elements().style({ opacity: 0.06 });

    // Highlight the neighborhood
    neighborhood.nodes().forEach((n: any) => {
      const ntype = n.data('type');
      if (activeFilters.size === 0 || activeFilters.has(ntype)) {
        n.style({ opacity: 1 });
      } else {
        n.style({ opacity: 0.35 });
      }
    });
    neighborhood.edges().style({ opacity: 0.8 });
    node.style({ opacity: 1, 'border-width': 3, 'border-color': '#818cf8', width: 26, height: 26 });

    // Zoom to fit
    cy.animate({
      fit: { eles: neighborhood, padding: 50 },
      duration: 400,
      easing: 'ease-out',
    });

    // Update info panel
    showInfoPanel(name, type, nId, neighbors.length);
    // Clear edge detail when focusing a new node
    const edgeDetail = document.getElementById('edge-detail');
    if (edgeDetail) edgeDetail.classList.add('hidden');
  }

  function showInfoPanel(name: string, type: string, nodeId: string, totalRels: number) {
    const infoPanel = document.getElementById('node-info');
    const infoName = document.getElementById('info-name');
    const infoType = document.getElementById('info-type');
    const infoDesc = document.getElementById('info-desc');
    const infoRels = document.getElementById('info-rels');

    if (infoPanel && infoName && infoType) {
      infoName.textContent = name;
      infoType.textContent = type;
      const color = TYPE_COLORS[type] || '#6b7280';
      infoType.style.background = color + '33';
      infoType.style.color = color;
      infoPanel.classList.remove('hidden');
    }
    if (infoDesc) {
      infoDesc.textContent = entityDescs[nodeId] || '';
    }
    if (infoRels) {
      infoRels.textContent = totalRels > 0
        ? `${totalRels} relationships`
        : 'No relationships';
    }
  }

  function updateHistoryButtons() {
    const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
    const btnFwd = document.getElementById('btn-forward') as HTMLButtonElement;
    if (btnBack) btnBack.disabled = historyIndex <= 0;
    if (btnFwd) btnFwd.disabled = historyIndex >= history.length - 1;
  }

  function clearFocus() {
    if (!cyInstance) return;
    cyInstance.nodes().style({ 'border-width': 1, 'border-color': '#2a2d3a', width: 18, height: 18 });
    applyTypeFilters();
    cyInstance.animate({ fit: { eles: cyInstance.elements(), padding: 30 }, duration: 300 });
    document.getElementById('node-info')?.classList.add('hidden');
  }

  function fuzzyMatch(query: string, text: string): boolean {
    query = query.toLowerCase();
    text = text.toLowerCase();
    if (text.includes(query)) return true;
    let qi = 0;
    for (let ti = 0; ti < text.length && qi < query.length; ti++) {
      if (text[ti] === query[qi]) qi++;
    }
    return qi === query.length;
  }

  async function start() {
    const dataUrl = document.getElementById('graph-data-url')!.getAttribute('data-url')!;
    const res = await fetch(dataUrl);
    const raw = await res.json();
    allSeedEdges = raw.seedEdges;
    entityDescs = raw.entityDescs;
    neighborMap = raw.neighborMap;

    loadedNodes.clear();
    loadedEdges.clear();
    const elements = toElements(allSeedEdges);

    cyInstance = cytoscape({
      container: document.getElementById('cy'),
      elements,
      style: [
        {
          selector: 'node',
          style: {
            'background-color': 'data(color)',
            label: 'data(label)',
            color: '#e5e7eb',
            'font-size': '9px',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            width: 18,
            height: 18,
            'border-width': 1,
            'border-color': '#2a2d3a',
            'text-max-width': '100px',
            'text-wrap': 'ellipsis',
          },
        },
        {
          selector: 'edge',
          style: {
            width: 1,
            'line-color': '#2a2d3a',
            'target-arrow-color': '#2a2d3a',
            'target-arrow-shape': 'triangle',
            'arrow-scale': 0.6,
            'curve-style': 'bezier',
          },
        },
      ],
      layout: {
        name: 'cose',
        animate: false,
        nodeOverlap: 20,
        idealEdgeLength: 80,
        nodeRepulsion: function () { return 8000; },
        gravity: 0.25,
      },
    });

    document.getElementById('graph-loading')?.remove();
    const cy = cyInstance;

    // --- Type filter toggle buttons ---
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).getAttribute('data-type')!;
        if (activeFilters.has(type)) {
          activeFilters.delete(type);
          setButtonActive(btn as HTMLElement, false);
        } else {
          activeFilters.add(type);
          setButtonActive(btn as HTMLElement, true);
        }
        applyTypeFilters();
      });
    });

    // --- Node tap ---
    cy.on('tap', 'node', function (evt: any) {
      const node = evt.target;
      const nodeId = node.id();
      focusOnNode(cy, nodeId, true);
    });

    // --- Edge tap: show relationship detail in info card ---
    cy.on('tap', 'edge', function (evt: any) {
      const edge = evt.target;
      const edgeDetail = document.getElementById('edge-detail');
      const edgeInfo = document.getElementById('edge-info');
      if (!edgeDetail || !edgeInfo) return;

      const relLabel = edge.data('label');
      const srcNode = edge.source();
      const tgtNode = edge.target();
      const srcName = srcNode.data('fullName');
      const srcType = srcNode.data('type');
      const tgtName = tgtNode.data('fullName');
      const tgtType = tgtNode.data('type');
      const srcColor = TYPE_COLORS[srcType] || '#6b7280';
      const tgtColor = TYPE_COLORS[tgtType] || '#6b7280';

      edgeInfo.innerHTML =
        `<div style="display:flex;align-items:center;gap:4px;margin-bottom:4px;">` +
        `<span style="width:8px;height:8px;border-radius:50%;background:${srcColor};flex-shrink:0;"></span>` +
        `<span style="color:#e5e7eb;">${srcName}</span>` +
        `</div>` +
        `<div style="padding-left:12px;color:#818cf8;font-size:10px;margin-bottom:4px;">&#8595; ${relLabel}</div>` +
        `<div style="display:flex;align-items:center;gap:4px;">` +
        `<span style="width:8px;height:8px;border-radius:50%;background:${tgtColor};flex-shrink:0;"></span>` +
        `<span style="color:#e5e7eb;">${tgtName}</span>` +
        `</div>`;

      edgeDetail.classList.remove('hidden');

      // Highlight the edge
      edge.style({ 'line-color': '#818cf8', 'target-arrow-color': '#818cf8', width: 2 });
    });

    // --- Tap on background: clear focus ---
    cy.on('tap', function (evt: any) {
      if (evt.target === cy) {
        clearFocus();
        const edgeDetail = document.getElementById('edge-detail');
        if (edgeDetail) edgeDetail.classList.add('hidden');
      }
    });

    // --- Close button = reset view (keep filters) ---
    document.getElementById('close-info')?.addEventListener('click', () => {
      history.length = 0;
      historyIndex = -1;
      updateHistoryButtons();
      clearFocus();
    });

    // --- History navigation ---
    document.getElementById('btn-back')?.addEventListener('click', () => {
      if (historyIndex > 0) {
        historyIndex--;
        updateHistoryButtons();
        focusOnNode(cy, history[historyIndex], false);
      }
    });

    document.getElementById('btn-forward')?.addEventListener('click', () => {
      if (historyIndex < history.length - 1) {
        historyIndex++;
        updateHistoryButtons();
        focusOnNode(cy, history[historyIndex], false);
      }
    });

    // --- Search ---
    const searchInput = document.getElementById('graph-search') as HTMLInputElement;
    const searchResults = document.getElementById('search-results')!;

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.trim();
      if (q.length < 2) {
        searchResults.classList.add('hidden');
        searchResults.innerHTML = '';
        return;
      }

      // Get all node names from the graph
      const allNodes: { id: string; name: string; type: string }[] = [];
      cy.nodes().forEach((n: any) => {
        allNodes.push({ id: n.id(), name: n.data('fullName'), type: n.data('type') });
      });
      // Also search pre-fetched neighbor data for nodes not yet on graph
      for (const key of Object.keys(entityDescs)) {
        const [name, type] = key.split('::');
        if (!loadedNodes.has(key)) {
          allNodes.push({ id: key, name, type });
        }
      }

      // Filter by search + active type filters
      let matches = allNodes.filter(n => fuzzyMatch(q, n.name));
      if (activeFilters.size > 0) {
        matches = matches.filter(n => activeFilters.has(n.type));
      }
      matches = matches.slice(0, 12);

      if (matches.length === 0) {
        searchResults.innerHTML = '<div style="padding:6px 10px;font-size:11px;color:#9ca3af;">No matches</div>';
        searchResults.classList.remove('hidden');
        return;
      }

      searchResults.innerHTML = matches.map(m => {
        const color = TYPE_COLORS[m.type] || '#6b7280';
        return `<div class="search-item" data-node-id="${m.id}" style="padding:5px 10px;cursor:pointer;display:flex;align-items:center;gap:6px;border-bottom:1px solid #2a2d3a;">
          <span style="width:8px;height:8px;border-radius:50%;background:${color};flex-shrink:0;"></span>
          <span style="font-size:11px;color:#e5e7eb;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${m.name}</span>
          <span style="font-size:9px;color:#9ca3af;flex-shrink:0;">${m.type}</span>
        </div>`;
      }).join('');
      searchResults.classList.remove('hidden');

      // Click handlers on results
      searchResults.querySelectorAll('.search-item').forEach(item => {
        item.addEventListener('click', () => {
          const nodeId = (item as HTMLElement).getAttribute('data-node-id')!;

          // If node not on graph yet, try to add it via neighbor data
          if (!cy.getElementById(nodeId).length) {
            const [name, type] = nodeId.split('::');
            const nKey = `${name}::${type}`;
            const neighbors = neighborMap[nKey] || [];
            if (neighbors.length > 0) {
              const newEls = toElements(neighbors);
              if (newEls.length > 0) {
                cy.add(newEls);
                cy.layout({ name: 'cose', animate: false, nodeOverlap: 20, idealEdgeLength: 80, nodeRepulsion: function() { return 8000; }, gravity: 0.25 }).run();
              }
            }
          }

          focusOnNode(cy, nodeId, true);
          searchResults.classList.add('hidden');
          searchInput.value = '';
        });
      });
    });

    // Hide search results on blur (with delay for click)
    searchInput?.addEventListener('blur', () => {
      setTimeout(() => searchResults.classList.add('hidden'), 200);
    });

    // --- Reset button ---
    document.getElementById('btn-reset')?.addEventListener('click', () => {
      activeFilters.clear();
      history.length = 0;
      historyIndex = -1;
      updateHistoryButtons();
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        setButtonActive(btn as HTMLElement, false);
      });
      loadedNodes.clear();
      loadedEdges.clear();
      cyInstance.elements().remove();
      const els = toElements(allSeedEdges);
      cyInstance.add(els);
      cyInstance.layout({
        name: 'cose', animate: false, nodeOverlap: 20, idealEdgeLength: 80,
        nodeRepulsion: function () { return 8000; }, gravity: 0.25,
      }).run();
      cyInstance.fit(undefined, 30);
      document.getElementById('node-info')?.classList.add('hidden');
      if (searchInput) searchInput.value = '';
      searchResults.classList.add('hidden');
    });

    updateHistoryButtons();
  }

  start();
</script>
