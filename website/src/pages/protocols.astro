---
import Layout from '../layouts/Layout.astro';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

let protocols: any[] = [];
let projects: any[] = [];
let protocolRels: any[] = [];
let projectRels: any[] = [];
try {
  const [protRes, projRes, protRelRes, projRelRes] = await Promise.all([
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Protocol" RETURN e.name as name, e.description as description, e.aliases as aliases ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Project" RETURN e.name as name, e.description as description, e.aliases as aliases ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity {type: "Protocol"})-[r]->(t:Entity) RETURN e.name as source, type(r) as rel, t.name as target, t.type as target_type`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity {type: "Project"})-[r]->(t:Entity) RETURN e.name as source, type(r) as rel, t.name as target, t.type as target_type`
    })}),
  ]);
  protocols = (await protRes.json()).results || [];
  projects = (await projRes.json()).results || [];
  protocolRels = (await protRelRes.json()).results || [];
  projectRels = (await projRelRes.json()).results || [];
} catch (e) {}

function buildRelMap(rels: any[]) {
  const map: Record<string, any[]> = {};
  for (const r of rels) {
    if (!map[r.source]) map[r.source] = [];
    map[r.source].push({ rel: r.rel, target: r.target, target_type: r.target_type });
  }
  return map;
}

const protRelMap = buildRelMap(protocolRels);
const projRelMap = buildRelMap(projectRels);

function formatRel(rel: string) {
  return rel.replace(/_/g, ' ').toLowerCase();
}

const typeColors: Record<string, string> = {
  Protocol: 'bg-blue-500/20 text-blue-300',
  Project: 'bg-emerald-500/20 text-emerald-300',
  Organization: 'bg-green-500/20 text-green-300',
  Person: 'bg-orange-500/20 text-orange-300',
  Group: 'bg-teal-500/20 text-teal-300',
  Capability: 'bg-purple-500/20 text-purple-300',
};

const featured = [
  { name: 'Model Context Protocol (MCP)', desc: 'Anthropic\'s protocol for connecting AI models to external tools, data sources, and capabilities. Defines how agents discover and invoke tools.' },
  { name: 'Agent-to-Agent Protocol (A2A)', desc: 'Google\'s protocol for inter-agent communication and task delegation. SDKs available in Python, JS, Java, Go, .NET.' },
  { name: 'Agent Network Protocol (ANP)', desc: 'Open-source protocol for agent networking, discovery, and collaboration. Community-governed with steering committee.' },
  { name: 'AGNTCY / ACP / SLIM', desc: 'Consortium focused on agentic workflows. Includes Agent Connect Protocol, SLIM runtime protocol, and Directory Service.' },
  { name: 'OpenSandbox', desc: 'Alibaba\'s sandboxed execution environment for AI agents. Provides isolated containers with fine-grained resource control.' },
  { name: 'Agent Governance Toolkit (AGT)', desc: 'Microsoft\'s toolkit for agent policy enforcement, audit compliance, and trust verification.' },
  { name: 'AI Catalog', desc: 'Specification for machine-readable agent capability descriptions. Enables discovery and interoperability.' },
  { name: 'AG UI', desc: 'Agent User Interface protocol for standardizing how agents present information to users.' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Protocols & Projects" description="Protocols and projects indexed in the agents-kg knowledge graph">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-16">
      <h1 class="text-3xl font-bold text-white">Protocols & Projects</h1>
      <p class="mt-4 text-muted max-w-2xl">
        The KG indexes {protocols.length.toLocaleString()} protocols and {projects.length.toLocaleString()} projects
        in the agentic technology ecosystem.
      </p>
    </section>

    <section class="pb-12">
      <h2 class="text-xl font-semibold text-white mb-6">Featured Protocols</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {featured.map((f) => (
          <div class="bg-surface border border-border rounded-lg p-5">
            <h3 class="text-white font-semibold">{f.name}</h3>
            <p class="text-sm text-muted mt-2">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-xl font-semibold text-white mb-2">All Protocols ({protocols.length.toLocaleString()})</h2>
      <p class="text-sm text-muted mb-6">Every protocol, specification, and standard tracked in the knowledge graph.</p>
      <div class="space-y-1.5">
        {protocols.map((p: any) => {
          const rels = (protRelMap[p.name] || []).slice(0, 5);
          const hasDetail = p.description || rels.length > 0;
          return hasDetail ? (
            <details class="group bg-surface border border-border rounded-lg">
              <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{p.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 shrink-0">Protocol</span>
              </summary>
              <div class="px-4 pb-4 pt-1 border-t border-border/50 ml-6">
                {p.description && <p class="text-sm text-muted">{p.description}</p>}
                {p.aliases && <p class="text-xs text-muted mt-1">Also known as: {p.aliases}</p>}
                {rels.length > 0 && (
                  <div class="mt-3 space-y-1">
                    <p class="text-xs font-medium text-muted uppercase tracking-wider">Relationships</p>
                    {rels.map((r: any) => (
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="text-muted">{formatRel(r.rel)}</span>
                        <span class="text-gray-300">{r.target}</span>
                        <span class={`px-1 py-0.5 rounded text-[10px] ${typeColors[r.target_type] || 'bg-gray-500/20 text-gray-400'}`}>{r.target_type}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ) : (
            <div class="bg-surface border border-border rounded-lg px-4 py-2.5 flex items-center gap-2">
              <span class="w-4" />
              <span class="text-sm text-gray-300">{p.name}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 shrink-0">Protocol</span>
            </div>
          );
        })}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-xl font-semibold text-white mb-2">All Projects ({projects.length.toLocaleString()})</h2>
      <p class="text-sm text-muted mb-6">Software projects, SDKs, implementations, and tools in the agentic ecosystem.</p>
      <div class="space-y-1.5">
        {projects.map((p: any) => {
          const rels = (projRelMap[p.name] || []).slice(0, 5);
          const hasDetail = p.description || rels.length > 0;
          return hasDetail ? (
            <details class="group bg-surface border border-border rounded-lg">
              <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{p.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 shrink-0">Project</span>
              </summary>
              <div class="px-4 pb-4 pt-1 border-t border-border/50 ml-6">
                {p.description && <p class="text-sm text-muted">{p.description}</p>}
                {p.aliases && <p class="text-xs text-muted mt-1">Also known as: {p.aliases}</p>}
                {rels.length > 0 && (
                  <div class="mt-3 space-y-1">
                    <p class="text-xs font-medium text-muted uppercase tracking-wider">Relationships</p>
                    {rels.map((r: any) => (
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="text-muted">{formatRel(r.rel)}</span>
                        <span class="text-gray-300">{r.target}</span>
                        <span class={`px-1 py-0.5 rounded text-[10px] ${typeColors[r.target_type] || 'bg-gray-500/20 text-gray-400'}`}>{r.target_type}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ) : (
            <div class="bg-surface border border-border rounded-lg px-4 py-2.5 flex items-center gap-2">
              <span class="w-4" />
              <span class="text-sm text-gray-300">{p.name}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 shrink-0">Project</span>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</Layout>
