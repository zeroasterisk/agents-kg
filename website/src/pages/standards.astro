---
import Layout from '../layouts/Layout.astro';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

let orgs: any[] = [];
let groups: any[] = [];
let orgRels: any[] = [];
let groupRels: any[] = [];
try {
  const [orgsRes, groupsRes, orgRelRes, groupRelRes] = await Promise.all([
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Organization" RETURN e.name as name, e.description as description, e.aliases as aliases ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Group" RETURN e.name as name, e.description as description, e.aliases as aliases ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity {type: "Organization"})-[r]->(t:Entity) RETURN e.name as source, type(r) as rel, t.name as target, t.type as target_type`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity {type: "Group"})-[r]->(t:Entity) RETURN e.name as source, type(r) as rel, t.name as target, t.type as target_type`
    })}),
  ]);
  orgs = (await orgsRes.json()).results || [];
  groups = (await groupsRes.json()).results || [];
  orgRels = (await orgRelRes.json()).results || [];
  groupRels = (await groupRelRes.json()).results || [];
} catch (e) {}

function buildRelMap(rels: any[]) {
  const map: Record<string, any[]> = {};
  for (const r of rels) {
    if (!map[r.source]) map[r.source] = [];
    map[r.source].push({ rel: r.rel, target: r.target, target_type: r.target_type });
  }
  return map;
}

const orgRelMap = buildRelMap(orgRels);
const groupRelMap = buildRelMap(groupRels);

function formatRel(rel: string) {
  return rel.replace(/_/g, ' ').toLowerCase();
}

const typeColors: Record<string, string> = {
  Protocol: 'bg-blue-500/20 text-blue-300',
  Project: 'bg-emerald-500/20 text-emerald-300',
  Organization: 'bg-green-500/20 text-green-300',
  Person: 'bg-orange-500/20 text-orange-300',
  Group: 'bg-teal-500/20 text-teal-300',
  Capability: 'bg-purple-500/20 text-purple-300',
};

const keyBodies = [
  { name: 'IETF', desc: 'Internet Engineering Task Force — 70+ agent-related drafts tracked covering OAuth, SCITT, HTTP signatures, and more.', url: 'https://www.ietf.org/' },
  { name: 'W3C', desc: '16+ working and community groups tracked — DID, Verifiable Credentials, Autonomous Agents, AI Knowledge Representation, and more.', url: 'https://www.w3.org/' },
  { name: 'AAIF', desc: 'Agent Attestation & Interoperability Forum — working groups on accuracy, agentic commerce, and agent trust.', url: null },
  { name: 'OpenID Foundation', desc: 'Standards for digital identity — OAuth, OIDC, FedCM, and emerging agent identity specifications.', url: 'https://openid.net/' },
  { name: 'OWASP', desc: 'Open Web Application Security Project — security guidelines relevant to agentic systems.', url: 'https://owasp.org/' },
  { name: 'FIDO Alliance', desc: 'Fast Identity Online — hardware-backed authentication standards used in agent credential systems.', url: 'https://fidoalliance.org/' },
  { name: 'NIST', desc: 'National Institute of Standards and Technology — AI risk frameworks and security guidelines.', url: 'https://www.nist.gov/' },
  { name: 'CNCF', desc: 'Cloud Native Computing Foundation — container, service mesh, and security standards adopted by agent platforms.', url: 'https://www.cncf.io/' },
  { name: 'CSA', desc: 'Cloud Security Alliance — Agentic Trust Framework working group.', url: 'https://cloudsecurityalliance.org/' },
  { name: 'CoSAI', desc: 'Coalition for Secure AI — working groups on secure design for agentic systems.', url: null },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Standards Landscape" description="Standards bodies and working groups tracked by the agents-kg knowledge graph">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-16">
      <h1 class="text-3xl font-bold text-white">Standards Landscape</h1>
      <p class="mt-4 text-muted max-w-2xl">
        The KG tracks {orgs.length} organizations and {groups.length} working groups involved in shaping the agentic technology ecosystem.
      </p>
    </section>

    <section class="pb-12">
      <h2 class="text-xl font-semibold text-white mb-6">Key Standards Bodies</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {keyBodies.map((body) => (
          <div class="bg-surface border border-border rounded-lg p-5">
            <div class="flex items-start justify-between">
              <h3 class="text-white font-semibold">{body.name}</h3>
              {body.url && (
                <a href={body.url} target="_blank" rel="noopener noreferrer" class="text-accent-light text-xs hover:underline ml-2 shrink-0">
                  website &rarr;
                </a>
              )}
            </div>
            <p class="text-sm text-muted mt-2">{body.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-xl font-semibold text-white mb-2">Working Groups & Community Groups ({groups.length})</h2>
      <p class="text-sm text-muted mb-6">Groups actively developing agent-related standards, discovered from W3C, IETF, AAIF, AGNTCY, and other bodies.</p>
      <div class="space-y-1.5">
        {groups.map((g: any) => {
          const rels = (groupRelMap[g.name] || []).slice(0, 5);
          const hasDetail = g.description || rels.length > 0;
          return hasDetail ? (
            <details class="group bg-surface border border-border rounded-lg">
              <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{g.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-teal-500/20 text-teal-300 shrink-0">Group</span>
              </summary>
              <div class="px-4 pb-4 pt-1 border-t border-border/50 ml-6">
                {g.description && <p class="text-sm text-muted">{g.description}</p>}
                {g.aliases && <p class="text-xs text-muted mt-1">Also known as: {g.aliases}</p>}
                {rels.length > 0 && (
                  <div class="mt-3 space-y-1">
                    <p class="text-xs font-medium text-muted uppercase tracking-wider">Relationships</p>
                    {rels.map((r: any) => (
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="text-muted">{formatRel(r.rel)}</span>
                        <span class="text-gray-300">{r.target}</span>
                        <span class={`px-1 py-0.5 rounded text-[10px] ${typeColors[r.target_type] || 'bg-gray-500/20 text-gray-400'}`}>{r.target_type}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ) : (
            <div class="bg-surface border border-border rounded-lg px-4 py-2.5 flex items-center gap-2">
              <span class="w-4" />
              <span class="text-sm text-gray-300">{g.name}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-teal-500/20 text-teal-300 shrink-0">Group</span>
            </div>
          );
        })}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-xl font-semibold text-white mb-2">All Organizations ({orgs.length})</h2>
      <p class="text-sm text-muted mb-6">Companies, foundations, and agencies referenced in the knowledge graph.</p>
      <div class="space-y-1.5">
        {orgs.map((o: any) => {
          const rels = (orgRelMap[o.name] || []).slice(0, 5);
          const hasDetail = o.description || rels.length > 0;
          return hasDetail ? (
            <details class="group bg-surface border border-border rounded-lg">
              <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{o.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-500/20 text-green-300 shrink-0">Organization</span>
              </summary>
              <div class="px-4 pb-4 pt-1 border-t border-border/50 ml-6">
                {o.description && <p class="text-sm text-muted">{o.description}</p>}
                {o.aliases && <p class="text-xs text-muted mt-1">Also known as: {o.aliases}</p>}
                {rels.length > 0 && (
                  <div class="mt-3 space-y-1">
                    <p class="text-xs font-medium text-muted uppercase tracking-wider">Relationships</p>
                    {rels.map((r: any) => (
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="text-muted">{formatRel(r.rel)}</span>
                        <span class="text-gray-300">{r.target}</span>
                        <span class={`px-1 py-0.5 rounded text-[10px] ${typeColors[r.target_type] || 'bg-gray-500/20 text-gray-400'}`}>{r.target_type}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ) : (
            <div class="bg-surface border border-border rounded-lg px-4 py-2.5 flex items-center gap-2">
              <span class="w-4" />
              <span class="text-sm text-gray-300">{o.name}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-500/20 text-green-300 shrink-0">Organization</span>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</Layout>
