---
import Layout from '../layouts/Layout.astro';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

let people: any[] = [];
let totalPeople = 0;
let personRels: any[] = [];
try {
  const [peopleRes, countRes, relRes] = await Promise.all([
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Person" AND e.description IS NOT NULL AND e.description <> "" RETURN e.name as name, e.description as description, e.aliases as aliases ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Person" RETURN count(e) as total`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity {type: "Person"})-[r]->(t:Entity) WHERE e.description IS NOT NULL AND e.description <> "" RETURN e.name as source, type(r) as rel, t.name as target, t.type as target_type`
    })}),
  ]);
  people = (await peopleRes.json()).results || [];
  const countData = await countRes.json();
  totalPeople = countData.results[0]?.total || 0;
  personRels = (await relRes.json()).results || [];
} catch (e) {}

function buildRelMap(rels: any[]) {
  const map: Record<string, any[]> = {};
  for (const r of rels) {
    if (!map[r.source]) map[r.source] = [];
    map[r.source].push({ rel: r.rel, target: r.target, target_type: r.target_type });
  }
  return map;
}

const personRelMap = buildRelMap(personRels);

function formatRel(rel: string) {
  return rel.replace(/_/g, ' ').toLowerCase();
}

const typeColors: Record<string, string> = {
  Protocol: 'bg-blue-500/20 text-blue-300',
  Project: 'bg-emerald-500/20 text-emerald-300',
  Organization: 'bg-green-500/20 text-green-300',
  Person: 'bg-orange-500/20 text-orange-300',
  Group: 'bg-teal-500/20 text-teal-300',
  Capability: 'bg-purple-500/20 text-purple-300',
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="People" description="Key individuals in the agentic technology space tracked by agents-kg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-16">
      <h1 class="text-3xl font-bold text-white">People</h1>
      <p class="mt-4 text-muted max-w-2xl">
        The KG tracks {totalPeople} individuals &mdash; chairs, editors, authors, and contributors
        shaping the agentic technology landscape. Showing {people.length} with known roles.
      </p>
    </section>

    <section class="pb-12">
      <div class="space-y-1.5">
        {people.map((p: any) => {
          const allPersonRels = personRelMap[p.name] || [];
          const rels = allPersonRels.slice(0, 3);
          const morePersonCount = allPersonRels.length - rels.length;
          const hasDetail = p.description || rels.length > 0;
          return hasDetail ? (
            <details class="group bg-surface border border-border rounded-lg">
              <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{p.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 shrink-0">Person</span>
              </summary>
              <div class="px-4 pb-4 pt-1 border-t border-border/50 ml-6">
                {p.description && <p class="text-sm text-muted">{p.description}</p>}
                {p.aliases && <p class="text-xs text-muted mt-1">Also known as: {p.aliases}</p>}
                {rels.length > 0 && (
                  <div class="mt-3 space-y-1">
                    <p class="text-xs font-medium text-muted uppercase tracking-wider">Relationships</p>
                    {rels.map((r: any) => (
                      <div class="flex items-center gap-1.5 text-xs">
                        <span class="text-muted">{formatRel(r.rel)}</span>
                        <span class="text-gray-300">{r.target}</span>
                        <span class={`px-1 py-0.5 rounded text-[10px] ${typeColors[r.target_type] || 'bg-gray-500/20 text-gray-400'}`}>{r.target_type}</span>
                      </div>
                    ))}
                    {morePersonCount > 0 && <p class="text-[10px] text-muted mt-1">+ {morePersonCount} more</p>}
                  </div>
                )}
              </div>
            </details>
          ) : (
            <div class="bg-surface border border-border rounded-lg px-4 py-2.5 flex items-center gap-2">
              <span class="w-4" />
              <span class="text-sm text-gray-300">{p.name}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 shrink-0">Person</span>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</Layout>
