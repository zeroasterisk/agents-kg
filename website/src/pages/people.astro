---
import Layout from '../layouts/Layout.astro';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

let people: any[] = [];
let totalPeople = 0;
try {
  const [peopleRes, countRes] = await Promise.all([
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Person" AND e.description IS NOT NULL AND e.description <> "" RETURN e.name as name, e.description as description ORDER BY e.name`
    })}),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({
      cypher: `MATCH (e:Entity) WHERE e.type = "Person" RETURN count(e) as total`
    })}),
  ]);
  const peopleData = await peopleRes.json();
  const countData = await countRes.json();
  people = peopleData.results || [];
  totalPeople = countData.results[0]?.total || 0;
} catch (e) {}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="People" description="Key individuals in the agentic technology space tracked by agents-kg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-16">
      <h1 class="text-3xl font-bold text-white">People</h1>
      <p class="mt-4 text-muted max-w-2xl">
        The KG tracks {totalPeople} individuals &mdash; chairs, editors, authors, and contributors
        shaping the agentic technology landscape. Showing {people.length} with known roles.
      </p>
    </section>

    <section class="pb-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {people.map((p: any) => (
          <div class="bg-surface border border-border rounded-lg px-4 py-3">
            <h3 class="text-white text-sm font-medium">{p.name}</h3>
            <p class="text-xs text-muted mt-1 line-clamp-2">{p.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
