---
import Layout from '../layouts/Layout.astro';

const API = 'http://35.202.188.73:8000';
const headers = {
  'Authorization': 'Bearer coordinator-agents-kg-2026',
  'Content-Type': 'application/json',
};

let stats = { total: 0, types: [] };
try {
  const [totalRes, typesRes] = await Promise.all([
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({ cypher: 'MATCH (e:Entity) RETURN count(e) as total' }) }),
    fetch(`${API}/query`, { method: 'POST', headers, body: JSON.stringify({ cypher: 'MATCH (e:Entity) RETURN e.type as type, count(*) as count ORDER BY count DESC' }) }),
  ]);
  const totalData = await totalRes.json();
  const typesData = await typesRes.json();
  stats.total = totalData.results[0]?.total || 0;
  stats.types = typesData.results || [];
} catch (e) {
  stats = { total: 12222, types: [
    { type: 'Capability', count: 6652 },
    { type: 'Protocol', count: 2422 },
    { type: 'Project', count: 1630 },
    { type: 'Person', count: 954 },
    { type: 'Organization', count: 419 },
    { type: 'Group', count: 145 },
  ]};
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sources = [
  'IETF (70+ drafts)', 'W3C (16+ Working Groups)', 'AAIF', 'AGNTCY', 'ANP',
  'OpenID', 'OWASP', 'NIST', 'FIDO', 'MCP', 'A2A', 'ai-catalog',
  'agentfinder', 'OpenSandbox', 'Agent Governance Toolkit', 'MORA',
];
---

<Layout title="Home">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight">
          Mapping the Agentic<br />Technology Landscape
        </h1>
        <p class="mt-6 text-lg text-muted leading-relaxed">
          A Neo4j-backed temporal knowledge graph covering protocols, standards, organizations, people, and projects in the agentic AI ecosystem. Queryable by humans and agents alike.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}/api.html`} class="inline-flex items-center px-5 py-2.5 bg-accent hover:bg-accent-light text-white text-sm font-medium rounded-lg transition-colors">
            Query the API
          </a>
          <a href={`${base}/standards.html`} class="inline-flex items-center px-5 py-2.5 bg-surface border border-border hover:border-accent text-white text-sm font-medium rounded-lg transition-colors">
            Browse Standards
          </a>
        </div>
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-8">Live Graph Statistics</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-surface border border-border rounded-lg p-5">
          <div class="text-3xl font-bold text-white">{stats.total.toLocaleString()}</div>
          <div class="text-sm text-muted mt-1">Total Entities</div>
        </div>
        {stats.types.map((t: any) => (
          <div class="bg-surface border border-border rounded-lg p-5">
            <div class="text-3xl font-bold text-white">{t.count.toLocaleString()}</div>
            <div class="text-sm text-muted mt-1">{t.type}s</div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-6">Ingested Sources</h2>
      <div class="flex flex-wrap gap-2">
        {sources.map((s) => (
          <span class="inline-flex items-center px-3 py-1.5 bg-surface border border-border rounded-md text-sm text-gray-300">
            {s}
          </span>
        ))}
      </div>
    </section>

    <section class="py-12 border-t border-border">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-6">Key Capabilities</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Structured Querying</h3>
          <p class="text-sm text-muted">Traverse relationships between protocols, projects, organizations, and people via Cypher queries.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Temporal Reasoning</h3>
          <p class="text-sm text-muted">Query how relationships and entities have changed over time: launches, adoptions, affiliation shifts.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Real-World Grounding</h3>
          <p class="text-sm text-muted">Entities linked to Wikidata identifiers, grounding the agentic domain in broad world knowledge.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Agent-Native Access</h3>
          <p class="text-sm text-muted">REST API that AI agents can call directly for planning, tool selection, and context gathering.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Extensible Ontology</h3>
          <p class="text-sm text-muted">Add new entity types, relationship types, and domain-specific metadata without schema migrations.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">Automated Ingestion</h3>
          <p class="text-sm text-muted">Hourly crawls discover new standards and specs. Weekly sweeps find emerging protocols and projects.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
