# KG API (the agents-kg REST API)
KG_API_URL=http://35.202.188.73:8000
KG_API_KEY=<your-agent-api-key-from-AGENT_API_KEYS>

# Google Cloud
GOOGLE_CLOUD_PROJECT=data-ingest-demo
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Neo4j (for reference — the agent uses the REST API, not direct Neo4j)
NEO4J_URI=bolt://35.202.188.73:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agents-kg-2026

# Model Armor (observe-only)
MODEL_ARMOR_TEMPLATE=projects/data-ingest-demo/locations/us-central1/templates/agent-standards-observe

# Session management
SESSION_TTL_SECONDS=86400
MAX_TURNS_PER_HOUR=30
